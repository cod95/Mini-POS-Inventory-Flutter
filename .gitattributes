# Auto-detect text files and normalise line endings to LF in the repository.
* text=auto eol=lf

# Dart / Flutter source files
*.dart text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.xml  text eol=lf
*.gradle text eol=lf
*.kts  text eol=lf
*.cmake text eol=lf
*.cc   text eol=lf
*.h    text eol=lf
*.cpp  text eol=lf
*.swift text eol=lf
*.properties text eol=lf
*.lock text eol=lf
*.xcconfig text eol=lf
*.storyboard text eol=lf

# Windows-specific files keep CRLF on checkout
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.rc   text eol=crlf
*.manifest text eol=crlf

# Binary files — do not attempt line-ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.eot  binary
*.jar  binary
*.zip  binary
*.apk  binary
*.aab  binary
*.pdf  binary
*.sqlite binary
*.db   binary
